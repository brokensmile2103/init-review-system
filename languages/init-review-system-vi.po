msgstr[0] "%s phản ứng"

msgid "Content Quality Guard"
msgstr "Bộ lọc chất lượng nội dung"

msgid "Pre-submit JS checks and banned words configuration (settings only)."
msgstr "Kiểm tra JS trước khi gửi và cấu hình từ bị cấm (chỉ phần cài đặt)."

msgid "Enable JS pre-submit checks"
msgstr "Bật kiểm tra JS trước khi gửi"

msgid "Run basic client-side checks before submit (e.g., excessive repeated words, missing whitespaces)."
msgstr "Chạy kiểm tra cơ bản phía trình duyệt trước khi gửi (ví dụ: từ lặp quá nhiều, thiếu khoảng trắng)."

msgid "Banned words (exact match, one per line)"
msgstr "Từ bị cấm (so khớp chính xác, mỗi dòng một từ)"

msgid "One word per line. Exact match (case-insensitive)."
msgstr "Mỗi dòng một từ. So khớp chính xác (không phân biệt hoa thường)."

msgid "Banned phrases (substring, one per line)"
msgstr "Cụm từ bị cấm (so khớp chuỗi con, mỗi dòng một cụm)"

msgid "One phrase per line. Substring contains check (case-insensitive)."
msgstr "Mỗi dòng một cụm từ. Kiểm tra chứa chuỗi con (không phân biệt hoa thường)."

msgid "Your review contains banned words."
msgstr "Bài đánh giá của bạn chứa từ bị cấm."

msgid "Your review contains banned phrases."
msgstr "Bài đánh giá của bạn chứa cụm từ bị cấm."

msgid "Your review appears to contain no whitespace. Please rewrite it more naturally."
msgstr "Bài đánh giá của bạn dường như không có khoảng trắng. Vui lòng viết lại tự nhiên hơn."

msgid "Your review repeats the same word too many times."
msgstr "Bài đánh giá của bạn lặp lại cùng một từ quá nhiều lần."

msgid "Please rate all required criteria."
msgstr "Vui lòng chấm điểm tất cả các tiêu chí bắt buộc."

msgid "Require double-click to rate"
msgstr "Yêu cầu nhấn hai lần để đánh giá"

msgid "Users must double-click a star to confirm rating."
msgstr "Người dùng phải nhấn hai lần vào ngôi sao để xác nhận đánh giá."

msgid "Helps prevent accidental ratings/misclicks."
msgstr "Giúp tránh trường hợp bấm nhầm khi đánh giá."

msgid "Avg"
msgstr "TB"

msgid "Votes"
msgstr "Lượt"

msgid "Total"
msgstr "Tổng"

msgid "Set Average (0–5)"
msgstr "Đặt điểm trung bình (0–5)"

msgid "Set Count (>= 0)"
msgstr "Đặt số lượt đánh giá (>= 0)"

msgid "Total auto = Avg × Count (rounded)"
msgstr "Tổng điểm tự động = Trung bình × Số lượt (được làm tròn)"

msgid "Reset all review data"
msgstr "Xóa toàn bộ dữ liệu đánh giá"

msgid "Save / Update the post to apply changes."
msgstr "Lưu / Cập nhật bài viết để áp dụng thay đổi."

msgid "No votes yet. This box appears after the first vote."
msgstr "Chưa có đánh giá. Metabox sẽ hiển thị sau khi có lượt đánh giá đầu tiên."

msgid "Abilities exposed by the Init Review System plugin."
msgstr "Các ability được plugin Init Review System cung cấp."

msgid "Get Review Score"
msgstr "Lấy điểm đánh giá"

msgid "Returns the average 5-star score and vote count for a post, the same data shown by the [init_review_score] shortcode."
msgstr "Trả về điểm trung bình (thang 5 sao) và số lượt đánh giá của một bài viết — cùng dữ liệu hiển thị bởi shortcode [init_review_score]."

msgid "The post ID to get the review score for."
msgstr "ID bài viết cần lấy điểm đánh giá."

msgid "A valid post ID is required."
msgstr "Cần một ID bài viết hợp lệ."

msgid "Get Criteria Reviews"
msgstr "Lấy đánh giá theo tiêu chí"

msgid "Returns the multi-criteria score breakdown and a page of written reviews for a post, the same data used by the [init_review_criteria] shortcode."
msgstr "Trả về điểm số chi tiết theo từng tiêu chí và một trang review bằng văn bản của một bài viết — cùng dữ liệu được shortcode [init_review_criteria] sử dụng."

msgid "The post ID to get reviews for."
msgstr "ID bài viết cần lấy danh sách đánh giá."

msgid "Page number of reviews to return."
msgstr "Số trang review cần trả về."

msgid "Number of reviews per page (max 100)."
msgstr "Số review mỗi trang (tối đa 100)."

msgid "Get Reactions Summary"
msgstr "Lấy tổng hợp reactions"

msgid "Returns emoji reaction counts for a post, the same data used by the [init_reactions] shortcode."
msgstr "Trả về số lượt reaction emoji của một bài viết — cùng dữ liệu được shortcode [init_reactions] sử dụng."

msgid "The post ID to get reactions for."
msgstr "ID bài viết cần lấy reactions."

